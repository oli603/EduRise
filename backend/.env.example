# ============================================================
# EDURISE BACKEND CONFIGURATION
# ============================================================

# Environment: development / staging / production
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=*

# Firebase Project ID
FIREBASE_PROJECT_ID=edurise-ethiopia

# Google Gemini API Configuration (Server-Side Only)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_OUTPUT_TOKENS=1024

# AI Rate Limiting & Quota Controls
RATE_LIMIT_PER_MINUTE=30
DAILY_COACH_LIMIT=15

# Cache & Idempotency Settings
CACHE_TTL_HOURS=720
IDEMPOTENCY_TTL_SECONDS=300
GENERATION_SCHEMA_VERSION=v1
